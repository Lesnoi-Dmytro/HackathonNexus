[Unit]
Description=Hackathon Nexus Recommendation API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/app
EnvironmentFile=/etc/api.env
ExecStart=/opt/recommendation-venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port ${PORT}
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
